# Dropbox API Configuration
# Required: Your Dropbox API credentials
DROPBOX_SHARED_LINK=https://www.dropbox.com/...
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Access token (short-lived, ~4 hours)
DROPBOX_ACCESS_TOKEN=your_access_token_here

# Refresh token (recommended for long operations - never expires)
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# Exploration Configuration
# Optional: Specify a subfolder within the shared link to explore
#ROOT_FOLDER=/subfolder/path

# Optional: Custom session name for organizing multiple explorations
#SESSION_NAME=my_custom_session

# Session Configuration
# How often to save progress (in seconds)
CHECKPOINT_INTERVAL_SECONDS=300

# Output directory for sessions and JSON exports
OUTPUT_DIR=data

# Logging Configuration
# Console log level: NONE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL_CONSOLE=INFO

# File log level: NONE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL_FILE=DEBUG

# Directory for log files
LOG_DIR=logs
